@model HelloWorld.ViewModel.CustomerViewModel
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>EnterCustomer</title>
</head>
    <script src="~/Scripts/jquery-3.7.0.js"></script>
    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="~/Scripts/Customer.js"></script>
    <script language="javascript">
                

          var app = angular.module("myApp", []);

          app.controller('CustomerViewModel', CustomerViewModel);

    </script>
<body ng-app="myApp">
    <a href="/Home/Index">Home</a>
    <br />

    <div>
        <div ng-controller="CustomerViewModel">
            <form id="frm1">
                <i>Customer Name </i><input id="CustomerName" ng-model="Customer.CustomerName" type="text" name="customer.CustomerName" /> <br />
                @Html.ValidationMessageFor(m => m.customer.CustomerName) <br />
                <i>Customer Code </i><input id="CustomerCode" ng-model="Customer.CustomerCode" type="text" name="customer.CustomerCode" /> <br />
                @Html.ValidationMessageFor(m => m.customer.CustomerCode) <br />
                <i>Customer Amount </i><input id="CustomerAmount" ng-model="Customer.CustomerAmount" style="background-color:{{Customer.CustomerAmountColor}}" type="text" name="customer.CustomerAmount" /> <br />
            </form>
            <br/>
            <input id="Btn" type="button" value="Add Customer" ng-click="Add()" />
            <input id="Btn1" type="button" value="Update Customer" ng-click="Update()" />
            <input id="Btn2" type="button" value="Delete Customer" ng-click="Delete()" />
            <br/>
            <li id="errorMessages" class="error" data-ng-repeat="error in Errors">{{error}}</li>

            </br>

            <table id="tbl">
                <tr>
                    <th>Customer Code</th>
                    <th>Customer Name</th>
                    <th>Customer Amount</th>
                </tr>
                <tr ng-repeat="cust in Customers">
                    <td>{{cust.CustomerCode}}</td>
                    <td>{{cust.CustomerName}}</td>
                    <td style="background-color:{{cust.CustomerAmountColor}}">{{cust.CustomerAmount}}</td>
                    <td><a ng-click="LoadByCode(cust.CustomerCode)" style="cursor:pointer;text-decoration:underline;">Select</a></td>
                </tr>
            </table>
        </div>
        
           
    </div>
</body>
</html>
