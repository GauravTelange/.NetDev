@model HelloWorld.ViewModel.CustomerViewModel

<h2>Search Customer</h2>

<form method="get" action="@Url.Action("SearchCustomer", "CustomerUI")">
    <label>Enter Customer Name :-</label>
    <input type="text" name="txtCustomerName" value="@Request.QueryString["txtCustomerName"]" />
    <button type="submit">Search Customer</button>
</form>

@if (Model?.customers != null && Model.customers.Any())
{
    <table>
        <thead>
            <tr>
                <th>Customer Code</th>
                <th>Customer Name</th>
                <th>Customer Amount</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model.customers)
        {
            <tr>
                <td>@c.CustomerCode</td>
                <td>@c.CustomerName</td>
                <td style="background:blue;color:white;">@c.CustomerAmount</td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <p>No results</p>
}       