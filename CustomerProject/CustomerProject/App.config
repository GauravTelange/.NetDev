<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<add name ="DbConn" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=Customerdb;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<appSettings>
		<add key="NameoftheApplication" value="Customer Management System"/>
		<add key="AddButton" value="Insert"/>
		<add key="UpdateButton" value="Update"/>
		<add key="DeleteButton" value="Delete"/>
	</appSettings>    
	<startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>